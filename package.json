{
  "name": "otoha",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Touch remote and home bridge for compatible Harman Kardon receivers and speakers",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/main.js",
    "dev": "node --watch server/main.js",
    "test": "node --test",
    "install:mac": "python3 scripts/install-mac.py",
    "add:all": "bash scripts/add-all.sh",
    "push:all": "bash scripts/push-all.sh",
    "pair:iphone": "node scripts/pair-iphone.js",
    "gateway": "node server/phone-gateway.js"
  }
}
