// Render the home remote's URL locally with macOS Core Image.
ObjC.import('AppKit');
ObjC.import('CoreImage');
function run(args) {
  const filter = $.CIFilter.filterWithName('CIQRCodeGenerator');
  filter.setValueForKey($(args[0]).dataUsingEncoding($.NSUTF8StringEncoding), 'inputMessage');
  const image = filter.outputImage;
  const context = $.CIContext.contextWithOptions($({}));
  const bitmap = $.NSBitmapImageRep.alloc.initWithCGImage(context.createCGImageFromRect(image, image.extent));
  const png = bitmap.representationUsingTypeProperties($.NSBitmapImageFileTypePNG, $({}));
  return ObjC.unwrap(png.base64EncodedStringWithOptions(0));
}
